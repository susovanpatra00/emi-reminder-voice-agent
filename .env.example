ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# Pick a Cartesia voice that speaks Hindi and English with an Indian accent
# (search "Indian" or "Hindi" in Cartesia's voice library and paste its ID).
CARTESIA_VOICE_ID=

# Optional
# BORROWER_ID=B001          # who the agent is calling
# LLM_MODEL=claude-haiku-5-5       # agent model (voice + evals)
# SIM_MODEL=claude-haiku-5-5       # simulated borrower in evals
# JUDGE_MODEL=claude-sonnet-5-5    # LLM judge in evals (set to claude-haiku-5-5 to save cost)
# CALL_DATE=2026-10-30      # pretend today is this date (default: real today; evals pin 2026-10-30)
# MOCK_LINK_DELAY=2.0       # seconds the payment-link tool takes
# MOCK_LINK_FAILURE=never   # never | first | always | random
# IDLE_TIMEOUT_SECS=7
